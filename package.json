{
  "name": "bandit-maintenance",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1 --port 4174 --strictPort",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bandit",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bandit \"node --test test/firestore.rules.test.mjs\""
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
