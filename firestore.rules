rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    // Keep the original client working while the new garage frontend rolls out.
    function validLegacyState(state) {
      return state.keys().hasAll(['version', 'vehicle', 'events', 'overrides'])
        && state.keys().hasOnly(['version', 'vehicle', 'events', 'overrides'])
        && state.version == 1
        && state.vehicle is map
        && state.vehicle.keys().hasAll(['model', 'year', 'km'])
        && state.vehicle.keys().hasOnly(['model', 'year', 'km'])
        && state.vehicle.model == 'Suzuki GSF650S'
        && state.vehicle.year == 2005
        && state.vehicle.km is int && state.vehicle.km >= 0
        && state.events is list && state.events.size() <= 5000
        && state.overrides is map && state.overrides.size() <= 38;
    }
    function validVehicleState(state) {
      return state.keys().hasAll(['version', 'vehicle', 'tasks', 'events', 'overrides'])
        && state.keys().hasOnly(['version', 'vehicle', 'tasks', 'events', 'overrides'])
        && state.version == 2
        && state.vehicle is map
        && state.vehicle.keys().hasAll(['make', 'model', 'year', 'km'])
        && state.vehicle.keys().hasOnly(['make', 'model', 'year', 'km'])
        && state.vehicle.make is string
        && state.vehicle.make.size() > 0 && state.vehicle.make.size() <= 100
        && state.vehicle.model is string
        && state.vehicle.model.size() > 0 && state.vehicle.model.size() <= 200
        && state.vehicle.year is int && state.vehicle.year >= 1886 && state.vehicle.year <= 2200
        && state.vehicle.km is int && state.vehicle.km >= 0
        && state.events is list && state.events.size() <= 5000
        && state.tasks is list && state.tasks.size() <= 1000
        && state.overrides is map && state.overrides.size() <= 1000;
    }
    function validNotebook(vehicleId) {
      let data = request.resource.data;
      return data.keys().hasAll(['state', 'revision', 'updatedAt'])
        && data.keys().hasOnly(['state', 'revision', 'updatedAt'])
        && data.revision is int && data.revision > 0
        && data.updatedAt == request.time
        && data.state is map
        && (validVehicleState(data.state)
          || (vehicleId == 'bandit' && validLegacyState(data.state)));
    }
    match /users/{uid}/preferences/interface {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['language', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['language', 'updatedAt'])
        && request.resource.data.language in ['en', 'ro']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /users/{uid}/notebooks/{vehicleId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validNotebook(vehicleId) && request.resource.data.revision == 1;
      allow update: if owns(uid) && validNotebook(vehicleId)
        && request.resource.data.revision == resource.data.revision + 1
        && (resource.data.state.version != 2 || request.resource.data.state.version == 2);
      allow delete: if owns(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
