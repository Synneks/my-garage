# Public Firebase Web config: Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# npm run dev uses this separate test project; builds keep the live settings above.
VITE_DEV_FIREBASE_API_KEY=
VITE_DEV_FIREBASE_AUTH_DOMAIN=my-garage-dev-72659.firebaseapp.com
VITE_DEV_FIREBASE_PROJECT_ID=my-garage-dev-72659
VITE_DEV_FIREBASE_APP_ID=

# Only enable for local tests with the Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=false
